# Delta-V environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# TLE data source: celestrak (default, no auth) or spacetrack (requires credentials below)
DATA_SOURCE=celestrak

# Space-Track.org credentials (only required if DATA_SOURCE=spacetrack)
SPACETRACK_USER=
SPACETRACK_PASS=

# IBM watsonx.ai credentials (optional — app falls back to template text if not set)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
